<div class="col-md-9 col-sm-9 col-xs-12">
    <form class="search-form" action="{{ t.searchUrl }}" method="get" autocomplete="off">
        <input class="search-input" type="search" name="q" value="">
        <button class="btn-search" type="submit">{{ t.search }}</button>
    </form>
</div>

<div class="col-md-3 col-sm-3 col-xs-12">
    <div class="btn-wrapper">
        <a href="{{ t.randomUrl }}" class="btn btn-secondary">Random</a>
    </div>
</div>

{{ set t = i18n[lang] }}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex">
    <title>{{ t.title }}</title>
    <script>
        var urls = {{ JSON.stringify(results.map((dream) => dream.url)) }};
        location.replace(urls[Math.floor(Math.random() * urls.length)]);
    </script>
    <noscript><meta http-equiv="refresh" content="0; url={{ t.home }}"></noscript>
</head>
<body></body>
</html>
